							"pm.test(\"Validate services list is array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(Array.isArray(jsonData)).to.be.true;",
							"    pm.expect(jsonData.length).to.be.at.least(2);",
							"});"
						],
						"type": "text/javascript"
					}
